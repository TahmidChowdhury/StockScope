# Copy to .env. Use distinct private passwords; never commit real credentials.
ADMIN_PASSWORD=replace-with-private-admin-password
DEMO_PASSWORD=replace-with-private-demo-password
GUEST_PASSWORD=replace-with-private-guest-password

# Required independent signing secret, at least 32 characters.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Frontend origins allowed to call the API (comma separated).
FRONTEND_ORIGINS=http://localhost:3000
# Production: FRONTEND_ORIGINS=https://stock-scope-green.vercel.app

# Optional Supabase Postgres owner connection, backend only. See README setup.
# Copy the exact direct/session-pooler URI from Supabase Connect; add sslmode=require.
# DATABASE_URL=

# Disclosure snapshots refresh automatically when DATABASE_URL is configured.
# Explicit false pauses collection; explicit true also enables local file mode.
# DISCLOSURE_COLLECTION_ENABLED=true
# Refresh interval in whole hours (1-24, default 6). Failed attempts retry sooner.
DISCLOSURE_COLLECTION_INTERVAL_HOURS=6

# File-mode snapshots when DATABASE_URL is absent. Use persistent storage in production.
# STOCKSCOPE_DATA_DIR=/app/data

# New providers: configured company IR feeds and GDELT article discovery.
STOCKSCOPE_IR_ENABLED=true
STOCKSCOPE_GDELT_ENABLED=true

# Required to enable SEC company facts: your app name and real contact email.
# SEC_USER_AGENT=StockScope your-email@example.com

# Optional storage budget: comma-separated taxonomy:concept identifiers.
# Empty/unset collects all supported concepts and preserves filing versions.
# SEC_FACT_CONCEPTS=us-gaap:Assets,us-gaap:Liabilities,us-gaap:NetIncomeLoss
